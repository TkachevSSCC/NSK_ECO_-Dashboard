CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
DB_NAME=

# --- Интеграция с платформой СИГМА ---
# Пусто = выключено. Значения выдаёт tools/sigma_setup.py.
SIGMA_ENABLED=false
SIGMA_ENDPOINT_URL=https://fwsigma.nsu.ru/api-gateway
SIGMA_KEYCLOAK_URL=https://fwsigma.nsu.ru/keycloak
SIGMA_REALM=sigma
SIGMA_APP_ID=
SIGMA_SECRET_KEY=
SIGMA_SOURCE_ID=
SIGMA_SOURCE_NAME=nsk-eco-stations
SIGMA_SOURCE_DOMAIN=nsk-eco

# Отправка: срез сети раз в 5 минут, кулдауны на повторные события
SIGMA_SNAPSHOT_INTERVAL=300
SIGMA_STATION_COOLDOWN=600
SIGMA_NETWORK_COOLDOWN=300
SIGMA_MAX_EVENTS_PER_MINUTE=30
SIGMA_POLL_INTERVAL=2
SIGMA_MAX_ATTEMPTS=8
SIGMA_OUTBOX_MAX=5000
SIGMA_OUTBOX_TTL=86400

# Демо-обогащение через PATCH (в бою уровень назначает Kafka-обработчик)
SIGMA_DEMO_ENRICH=false
# Кнопка «Проверить связь» во вкладке «Управление»
SIGMA_TEST_ENABLED=true